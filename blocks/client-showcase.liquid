{%- doc -%}
  Client showcase panel for the "Custom straws" homepage section.
  A solid dark green panel with a photo card on it. Tapping a client name
  switches the card. Add clients as blocks inside this block
  (needs blocks/_client-showcase-item.liquid).
{%- enddoc -%}

{%- liquid
  assign pill_font = block.settings.pill_font
-%}

<style>
  {{ pill_font | font_face: font_display: 'swap' }}
</style>

<div
  class="cs-show"
  data-cs-show="{{ block.id }}"
  style="
    --cs-bg: {{ block.settings.background_color }};
    --cs-min-height: {{ block.settings.min_height }}px;
    --cs-pill-family: {{ pill_font.family }}, {{ pill_font.fallback_families }};
    --cs-pill-weight: {{ pill_font.weight }};
    --cs-pill-style: {{ pill_font.style }};
    --cs-pill-size: {{ block.settings.pill_size }}px;
    --cs-pill-spacing: {{ block.settings.pill_letter_spacing }}px;
    --cs-pill-case: {{ block.settings.pill_case }};
  "
  {{ block.shopify_attributes }}
>
  <div class="cs-show__items">
    {% content_for 'blocks' %}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-cs-show="{{ block.id }}"]');
    if (!root) return;

    function select(id) {
      var pills = root.querySelectorAll('[data-cs-pill]');
      var cards = root.querySelectorAll('[data-cs-card]');
      if (!pills.length) return;

      var found = false;
      pills.forEach(function (pill) {
        if (pill.getAttribute('data-cs-pill') === id) found = true;
      });
      if (!found) id = pills[0].getAttribute('data-cs-pill');

      root.setAttribute('data-active', id);
      cards.forEach(function (card) {
        card.classList.toggle('is-active', card.getAttribute('data-cs-card') === id);
      });
      pills.forEach(function (pill) {
        pill.setAttribute('aria-pressed', pill.getAttribute('data-cs-pill') === id ? 'true' : 'false');
      });
    }

    root.addEventListener('click', function (event) {
      var pill = event.target.closest('[data-cs-pill]');
      if (pill) select(pill.getAttribute('data-cs-pill'));
    });

    // Keep the chosen client when the theme editor redraws a block.
    new MutationObserver(function () {
      select(root.getAttribute('data-active'));
    }).observe(root, { childList: true, subtree: true });

    // In the theme editor, clicking a client in the sidebar shows that client.
    document.addEventListener('shopify:block:select', function (event) {
      if (root.contains(event.target)) {
        var card = event.target.querySelector('[data-cs-card]');
        if (card) select(card.getAttribute('data-cs-card'));
      }
    });

    select(root.getAttribute('data-active'));
  })();
</script>

{% stylesheet %}
  .cs-show {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    align-self: stretch;
    width: auto;
    min-height: var(--cs-min-height, 0px);
    padding: 3.2rem 3.2rem;
    /* Stretch over the padding of the group this block sits in, so the green reaches every edge. */
    margin-block: calc(-1 * var(--padding-block-start, 0px)) calc(-1 * var(--padding-block-end, 0px));
    margin-inline: calc(-1 * var(--padding-inline-start, 0px)) calc(-1 * var(--padding-inline-end, 0px));
    background-color: var(--cs-bg, #1D3932);
    color: #FBF8F1;
  }

  .cs-show__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 36rem;
  }

  @media screen and (max-width: 749px) {
    .cs-show {
      min-height: 0;
      padding: 2.4rem 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Client showcase",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Panel background",
      "default": "#1D3932"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "info": "0 lets the panel fit its content. Raise it only if the panel needs to be taller.",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    { "type": "header", "content": "Client name buttons" },
    {
      "type": "font_picker",
      "id": "pill_font",
      "label": "Font",
      "default": "montserrat_n5"
    },
    {
      "type": "range",
      "id": "pill_size",
      "label": "Text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "pill_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "px",
      "default": 0.4
    },
    {
      "type": "select",
      "id": "pill_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalise" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    { "type": "_client-showcase-item" }
  ],
  "presets": [
    {
      "name": "Client showcase",
      "blocks": [
        { "type": "_client-showcase-item", "settings": { "name": "Client one", "city": "City", "color": "#03754B" } },
        { "type": "_client-showcase-item", "settings": { "name": "Client two", "city": "City", "color": "#B5532F" } },
        { "type": "_client-showcase-item", "settings": { "name": "Client three", "city": "City", "color": "#1F3A5F" } }
      ]
    }
  ]
}
{% endschema %}
