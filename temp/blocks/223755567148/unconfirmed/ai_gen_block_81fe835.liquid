{% doc %}
  @prompt
    a simple pill with rounded corners. inside content of the pill – an icon on the left and text on the right. non clicable, just to highlight features, looks good, just add a border option to it with the option to change the border colour and border thickness, add the options to change the typographt of the text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-feature-pill-{{ ai_gen_id }} { display: inline-flex; align-items: center; gap: 9px; box-sizing: border-box; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; padding: 9px 16px; border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }}; border-radius: {{ block.settings.corner_radius }}px; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; }
  .ai-feature-pill-{{ ai_gen_id }}__icon { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 20px; height: 20px; color: {{ block.settings.icon_color }}; }
  .ai-feature-pill-{{ ai_gen_id }}__icon svg { display: block; width: 100%; height: 100%; }
  .ai-feature-pill-{{ ai_gen_id }}__text { margin: 0; font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }}; font-style: {{ block.settings.text_font.style }}; font-weight: {{ block.settings.text_font.weight }}; font-size: {{ block.settings.text_size }}px; line-height: 1.35; text-transform: {{ block.settings.text_transform }}; letter-spacing: {{ block.settings.letter_spacing }}px; }
{% endstyle %}
<div class="ai-feature-pill-{{ ai_gen_id }}" role="note" {{ block.shopify_attributes }}>
  <span class="ai-feature-pill-{{ ai_gen_id }}__icon" aria-hidden="true">
    {% case block.settings.icon_style %}
      {% when 'leaf' %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4c-8.5 0-14 3.5-14 10a6 6 0 0 0 6 6c6.5 0 8-7.5 8-16Z"/><path d="M4 21c2.5-5.5 6.5-8.5 12-11"/></svg>
      {% when 'check' %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16.5 9"/></svg>
      {% when 'sparkle' %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/></svg>
      {% when 'heart' %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.8c0 5.2-8.8 10-8.8 10s-8.8-4.8-8.8-10A4.8 4.8 0 0 1 12 6.5a4.8 4.8 0 0 1 8.8 2.3Z"/></svg>
    {% endcase %}
  </span>
  <span class="ai-feature-pill-{{ ai_gen_id }}__text">{{ block.settings.pill_text | escape }}</span>
</div>
{% schema %}
{
  "name": "Feature pill",
  "settings": [
    { "type": "text", "id": "pill_text", "label": "Text", "default": "Thoughtfully made for everyday" },
    { "type": "select", "id": "icon_style", "label": "Icon", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "check", "label": "Check" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }], "default": "leaf" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 10, "max": 50, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "text_font", "label": "Font", "default": "montserrat_n4" },
    { "type": "range", "id": "text_size", "label": "Size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "select", "id": "text_transform", "label": "Text case", "options": [{ "value": "none", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "none" },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0, "max": 2, "step": 0.5, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#D4E8E2" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1D3932" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#03754B" },
    { "type": "header", "content": "Border" },
    { "type": "range", "id": "border_thickness", "label": "Thickness", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1 },
    { "type": "color", "id": "border_color", "label": "Color", "default": "#1D3932" }
  ],
  "presets": [{ "name": "Feature pill" }],
  "tag": null,
  "class": "feature-pill-block"
}
{% endschema %}