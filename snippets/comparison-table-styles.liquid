{%- doc -%}
  Styles for the comparison-table block and its _comparison-row children.

  @example
  {% render 'comparison-table-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .comparison-table {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .comparison-table__eyebrow {
    font-family: var(--font-h6--family);
    font-weight: var(--font-h6--weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 1.3rem;
    color: var(--color-foreground-muted, var(--color-foreground));
    margin: 0;
  }

  .comparison-table__heading {
    margin: 0;
  }

  .comparison-table__grid {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-sm, 8px);
    overflow: hidden;
  }

  .comparison-table-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 1rem;
    padding: 1.2rem 1.6rem;
    align-items: center;
    border-block-end: 1px solid var(--color-border);
  }

  .comparison-table-row:last-child {
    border-block-end: none;
  }

  .comparison-table-row--header {
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-weight: 600;
  }

  .comparison-table-row__cell {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .comparison-table-row__cell .svg-wrapper {
    width: var(--icon-size-md, 16px);
    height: var(--icon-size-md, 16px);
    flex-shrink: 0;
  }

  @media (max-width: 989px) {
    .comparison-table-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1rem 1.4rem;
    }

    .comparison-table-row__feature {
      font-weight: 600;
    }
  }
{% endstylesheet %}
