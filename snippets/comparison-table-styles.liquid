{%- doc -%}
  Styles for the comparison-table block and its _comparison-row children.

  @example
  {% render 'comparison-table-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .comparison-table {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    width: 100%;
    max-width: 34rem;
    margin-inline: 0;
  }

  .comparison-table__eyebrow {
    font-family: var(--font-h6--family);
    font-weight: var(--font-h6--weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 1.3rem;
    color: var(--color-foreground-muted, var(--color-foreground));
    margin: 0;
  }

  .comparison-table__heading {
    margin: 0;
  }

  .comparison-table__grid {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-sm, 8px);
    overflow: hidden;
  }

  .comparison-table-row {
    padding: 1.2rem 1.6rem;
    border-block-end: 1px solid var(--color-border);
  }

  .comparison-table-row:last-child {
    border-block-end: none;
  }

  .comparison-table-row--header {
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-weight: 600;
  }

  .comparison-table-row__label {
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground-muted, var(--color-foreground));
    margin-block-end: 0.6rem;
  }

  .comparison-table-row__cells,
  .comparison-table-row--header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .comparison-table-row__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .comparison-table-row__cell span:last-child {
    overflow-wrap: anywhere;
  }

  .comparison-table-row__cell .svg-wrapper {
    width: var(--icon-size-md, 16px);
    height: var(--icon-size-md, 16px);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .comparison-table-row {
      padding: 1rem 1.2rem;
    }

    .comparison-table-row__cells,
    .comparison-table-row--header {
      gap: 0.8rem;
    }
  }
{% endstylesheet %}
