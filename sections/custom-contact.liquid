{% assign s = section.settings %}

<section class="custom-contact" style="background-color: {{ s.background_color }};">
  <div class="custom-contact__inner">

    {% if s.heading != blank or s.subheading != blank %}
      <div class="custom-contact__header">
        {% if s.heading != blank %}
          <h1 class="custom-contact__heading">{{ s.heading }}</h1>
        {% endif %}
        {% if s.subheading != blank %}
          <p class="custom-contact__subheading">{{ s.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="custom-contact__grid">

      {% comment %} Left column: contact details {% endcomment %}
      <div class="custom-contact__details">

        {% if s.whatsapp_number != blank %}
          <a
            href="{{ s.whatsapp_link | default: '#' }}"
            class="custom-contact__card custom-contact__card--whatsapp"
            {% if s.whatsapp_link != blank %}target="_blank" rel="noopener"{% endif %}
          >
            <div class="custom-contact__card-row">
              <span class="custom-contact__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.6.1-.2.3-.7.9-.9 1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 .9-1 2.3s1 2.7 1.2 2.9c.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.3c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.3 8.3 0 1 1 12 20.3z"/></svg>
              </span>
              <span class="custom-contact__card-text">
                <span class="custom-contact__card-label">WhatsApp / Call</span>
                <span class="custom-contact__card-value">{{ s.whatsapp_number }}</span>
              </span>
            </div>
            {% if s.whatsapp_note != blank %}
              <span class="custom-contact__card-note">{{ s.whatsapp_note }}</span>
            {% endif %}
          </a>
        {% endif %}

        {% if s.email != blank %}
          <a href="mailto:{{ s.email }}" class="custom-contact__card custom-contact__card--detail">
            <span class="custom-contact__icon custom-contact__icon--sm" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span class="custom-contact__card-text">
              <span class="custom-contact__card-label">Email</span>
              <span class="custom-contact__card-value custom-contact__card-value--sm">{{ s.email }}</span>
            </span>
          </a>
        {% endif %}

        {% if s.instagram_handle != blank %}
          <a
            href="{{ s.instagram_link | default: '#' }}"
            class="custom-contact__card custom-contact__card--detail"
            {% if s.instagram_link != blank %}target="_blank" rel="noopener"{% endif %}
          >
            <span class="custom-contact__icon custom-contact__icon--sm" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </span>
            <span class="custom-contact__card-text">
              <span class="custom-contact__card-label">Instagram</span>
              <span class="custom-contact__card-value custom-contact__card-value--sm">{{ s.instagram_handle }}</span>
            </span>
          </a>
        {% endif %}

        {% if s.address != blank %}
          <div class="custom-contact__card custom-contact__card--detail">
            <span class="custom-contact__icon custom-contact__icon--sm" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <span class="custom-contact__card-text">
              <span class="custom-contact__card-label">Office</span>
              <span class="custom-contact__card-value custom-contact__card-value--sm">{{ s.address }}</span>
            </span>
          </div>
        {% endif %}

      </div>

      {% comment %} Right column: contact form {% endcomment %}
      <div class="custom-contact__form-wrap">
        {% if s.bulk_note != blank %}
          <p class="custom-contact__bulk-note">{{ s.bulk_note }}</p>
        {% endif %}

        {% form 'contact', class: 'custom-contact__form' %}
          {% if form.posted_successfully? %}
            <p class="custom-contact__success">{{ s.success_message | default: "Thanks — we've got your message and will reply within one working day." }}</p>
          {% endif %}

          {% if form.errors %}
            <p class="custom-contact__error">{{ form.errors | default_errors }}</p>
          {% endif %}

          <label class="custom-contact__field">
            <span class="custom-contact__field-label">Name</span>
            <input type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}">
          </label>

          <label class="custom-contact__field">
            <span class="custom-contact__field-label">Phone</span>
            <input type="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}" required>
          </label>

          <label class="custom-contact__field">
            <span class="custom-contact__field-label">Email</span>
            <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" required>
          </label>

          <label class="custom-contact__field">
            <span class="custom-contact__field-label">What do you need?</span>
            <textarea name="contact[body]" rows="3" placeholder="Size, quantity, and whether it's for a café or wholesale">{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </label>

          <button type="submit" class="custom-contact__submit">{{ s.submit_label | default: 'Send' }}</button>
        {% endform %}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
  .custom-contact {
    width: 100%;
    padding: 4.8rem 0;
  }

  .custom-contact__inner {
    max-width: var(--page-width, 1280px);
    margin: 0 auto;
    padding: 0 clamp(2rem, 5vw, 5rem);
  }

  .custom-contact__header {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto 3.2rem;
  }

  .custom-contact__heading {
    margin: 0 0 0.8rem;
    font-family: var(--font-h1--family);
    font-weight: 700;
    font-size: clamp(3rem, 5vw, 4.2rem);
    line-height: 1.1;
    color: #1D3932;
  }

  .custom-contact__subheading {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.6;
    color: #4a5d57;
  }

  .custom-contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: start;
  }

  .custom-contact__details {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .custom-contact__card {
    display: block;
    text-decoration: none;
    border-radius: 14px;
    padding: 1.4rem 1.6rem;
  }

  .custom-contact__card--whatsapp {
    background-color: #03754B;
  }

  .custom-contact__card--detail {
    background-color: #FFFFFF;
    border: 1px solid #E2E0D6;
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .custom-contact__card-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .custom-contact__icon {
    flex-shrink: 0;
    color: #FBF8F1;
    display: inline-flex;
  }

  .custom-contact__icon--sm {
    color: #03754B;
    margin-top: 0.2rem;
  }

  .custom-contact__card-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .custom-contact__card--whatsapp .custom-contact__card-label {
    color: #FBF8F1;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .custom-contact__card--whatsapp .custom-contact__card-value {
    color: #FBF8F1;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .custom-contact__card-note {
    display: block;
    margin-top: 0.9rem;
    color: #D4E8E2;
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .custom-contact__card--detail .custom-contact__card-label {
    color: #7a8a84;
    font-size: 1.25rem;
  }

  .custom-contact__card-value--sm {
    color: #1D3932;
    font-size: 1.45rem;
    line-height: 1.5;
    word-break: break-word;
  }

  .custom-contact__form-wrap {
    background-color: #FFFFFF;
    border: 1px solid #E2E0D6;
    border-radius: 14px;
    padding: 2rem;
  }

  .custom-contact__bulk-note {
    margin: 0 0 1.6rem;
    background-color: #D4E8E2;
    border-radius: 10px;
    padding: 1rem 1.2rem;
    font-size: 1.35rem;
    line-height: 1.55;
    color: #1D3932;
  }

  .custom-contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .custom-contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .custom-contact__field-label {
    font-size: 1.3rem;
    color: #4a5d57;
  }

  .custom-contact__field input,
  .custom-contact__field textarea {
    width: 100%;
    background-color: #FBF8F1;
    border: 1px solid #E2E0D6;
    border-radius: 10px;
    padding: 1rem 1.2rem;
    font-size: 1.5rem;
    font-family: inherit;
    color: #1D3932;
    box-sizing: border-box;
  }

  .custom-contact__field textarea {
    resize: vertical;
  }

  .custom-contact__field input:focus,
  .custom-contact__field textarea:focus {
    outline: 2px solid #03754B;
    outline-offset: 1px;
    border-color: #03754B;
  }

  .custom-contact__submit {
    margin-top: 0.4rem;
    align-self: flex-start;
    background-color: #03754B;
    color: #FBF8F1;
    border: none;
    border-radius: 999px;
    padding: 1.2rem 3rem;
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    min-height: var(--minimum-touch-target, 44px);
  }

  .custom-contact__submit:hover {
    background-color: #1D3932;
  }

  .custom-contact__success {
    margin: 0 0 1.2rem;
    background-color: #D4E8E2;
    border-radius: 10px;
    padding: 1rem 1.2rem;
    font-size: 1.4rem;
    color: #1D3932;
  }

  .custom-contact__error {
    margin: 0 0 1.2rem;
    background-color: #FBEAEA;
    border-radius: 10px;
    padding: 1rem 1.2rem;
    font-size: 1.4rem;
    color: #8A2B2B;
  }

  @media screen and (max-width: 749px) {
    .custom-contact {
      padding: 3.2rem 0;
    }

    .custom-contact__inner {
      padding: 0 1.6rem;
    }

    .custom-contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom contact",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's talk straws." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Whether you run a café or a wholesale business, we're happy to help you find the right fit, send samples, or set up regular supply." },
    { "type": "header", "content": "WhatsApp" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp / phone number", "default": "+91 91111 29997" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link (wa.me)" },
    { "type": "textarea", "id": "whatsapp_note", "label": "WhatsApp note", "default": "Fastest way to reach us — bulk pricing, samples and reorders." },
    { "type": "header", "content": "Other details" },
    { "type": "text", "id": "email", "label": "Email", "default": "rachit@organipaks.in" },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "@organipaks" },
    { "type": "url", "id": "instagram_link", "label": "Instagram link" },
    { "type": "textarea", "id": "address", "label": "Office address", "default": "OrganiPaks India Pvt. Ltd., 344 Vikram Tower, Sapna Sangeeta Road, Indore, MP" },
    { "type": "header", "content": "Form" },
    { "type": "textarea", "id": "bulk_note", "label": "Bulk note above form", "default": "Buying in bulk (3,000+ pieces)? WhatsApp us for business pricing — it's quicker than the form." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send" },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Thanks — we've got your message and will reply within one working day. For anything urgent, WhatsApp us on +91 91111 29997." },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FBF8F1" }
  ],
  "presets": [
    { "name": "Custom contact", "category": "Contact" }
  ]
}
{% endschema %}
